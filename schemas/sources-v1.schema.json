{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/1-hive/hive-route/schemas/sources-v1.schema.json",
  "title": "hive-route sources, format 1: where a deployment's pool usage and qualifications are read from, and how its harnesses start",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format"
  ],
  "properties": {
    "format": {
      "const": "hive-route.sources/1"
    },
    "fresh_minutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_age_days": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "qualifications": {
      "type": "string",
      "minLength": 1
    },
    "pools": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reader",
            "paths"
          ],
          "properties": {
            "reader": {
              "enum": [
                "claude-stream",
                "codex-sessions"
              ]
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "canary_workdir": {
      "type": "string",
      "minLength": 1
    },
    "harnesses": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "effort_args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stdin": {
            "type": "boolean"
          },
          "aux_models": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Models the harness uses for itself, not for the route (e.g. Codex's approval reviewer); not drift."
          }
        }
      }
    }
  }
}
