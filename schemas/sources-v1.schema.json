{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/1-hive/hive-route/schemas/sources-v1.schema.json",
  "title": "hive-route sources, format 1: where a deployment's pool usage and qualifications are read from, and how its harnesses start",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format"
  ],
  "properties": {
    "format": {
      "const": "hive-route.sources/1"
    },
    "fresh_minutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_age_days": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "qualifications": {
      "type": "string",
      "minLength": 1
    },
    "pools": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reader",
            "paths"
          ],
          "properties": {
            "reader": {
              "enum": [
                "claude-stream",
                "codex-sessions",
                "http-health",
                "gateway-spend"
              ]
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "key_env": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]*$"
            },
            "down_minutes": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "env_file": {
              "type": "string",
              "minLength": 1,
              "description": "A KEY=value file holding key_env, for readers that call an authenticated endpoint."
            }
          }
        }
      }
    },
    "canary_workdir": {
      "type": "string",
      "minLength": 1
    },
    "harnesses": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "effort_args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stdin": {
            "type": "boolean"
          },
          "aux_models": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Models the harness uses for itself, not for the route (e.g. Codex's approval reviewer); not drift."
          },
          "gateway_args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Arguments added for a via_gateway route; {gateway_url} and {key_env} are filled in."
          },
          "gateway_env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Environment for a via_gateway route; values may use {gateway_url} and {gateway_key}."
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "key_env"
      ],
      "description": "The hive's gateway, for routes with via_gateway (\u00a78).",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "key_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "env_file": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
