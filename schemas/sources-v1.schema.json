{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/1-hive/hive-route/schemas/sources-v1.schema.json",
  "title": "hive-route sources, format 1: where a deployment's pool usage and qualifications are read from, and how its harnesses start",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format"
  ],
  "properties": {
    "format": {
      "const": "hive-route.sources/1"
    },
    "fresh_minutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_age_days": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "qualifications": {
      "type": "string",
      "minLength": 1
    },
    "pools": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reader",
            "paths"
          ],
          "properties": {
            "reader": {
              "enum": [
                "claude-stream",
                "codex-sessions",
                "http-health",
                "gateway-spend",
                "openclaw-sessions"
              ]
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "key_env": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]*$"
            },
            "down_minutes": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "env_file": {
              "type": "string",
              "minLength": 1,
              "description": "A KEY=value file holding key_env, for readers that call an authenticated endpoint."
            },
            "timeout_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "auth_header": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,64}$",
              "description": "http-health: the header the key goes in (default Authorization: Bearer)."
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "maxLength": 200
              },
              "description": "http-health: fixed headers to send (no secrets: keys come from key_env)."
            }
          }
        }
      }
    },
    "canary_workdir": {
      "type": "string",
      "minLength": 1
    },
    "harnesses": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "effort_args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stdin": {
            "type": "boolean"
          },
          "aux_models": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Models the harness uses for itself, not for the route (e.g. Codex's approval reviewer); not drift."
          },
          "gateway_args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Arguments added for a via_gateway route; {gateway_url} and {key_env} are filled in."
          },
          "gateway_env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Environment for a via_gateway route; values may use {gateway_url} and {gateway_key}."
          },
          "path_map": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "description": "Canaries: host path prefix -> the prefix the harness sees (e.g. inside a container), applied to {cwd}. The check still runs on the host path."
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "key_env"
      ],
      "description": "The hive's gateway, for routes with via_gateway (\u00a78).",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "key_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "env_file": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "probes": {
      "type": "object",
      "description": "Usage probes per pool (probe.py): a trivial harness call whose output refreshes the pool's window shares.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv",
          "output_dir"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "output_dir": {
            "type": "string",
            "minLength": 1,
            "description": "Where each run writes probe-<time>.jsonl; list it in the pool's reader paths."
          },
          "every_minutes": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "No sooner than this after the previous probe (default 60)."
          },
          "active_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Run only if one of these files changed since the previous probe (e.g. the agents' session databases)."
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "keep": {
            "type": "integer",
            "minimum": 1,
            "description": "Probe files kept (default 20)."
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Fixed, non-secret environment for the probe."
          },
          "env_from": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]*$"
            },
            "description": "Variables set from env_file (secrets such as CLAUDE_CODE_OAUTH_TOKEN), so the probe uses the agents' subscription."
          },
          "env_file": {
            "type": "string",
            "minLength": 1,
            "description": "A KEY=value file holding the env_from variables; read at each run, never copied."
          }
        }
      }
    }
  }
}
